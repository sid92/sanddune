# Copy this file to config.yaml and fill in real values.
# config.yaml is gitignored - it will contain your Telegram bot token, a secret.

detectors:
  tank_replenish:
    enabled: true
    rtsp_url: "rtsp://user:pass@camera-ip:554/stream"
    schedule:
      day: monday              # monday..sunday
      window_start_hour: 7     # 24h clock
      deadline_hour: 14        # 24h clock - the breach alert fires at this hour if
                               # nothing resolved. The compliant alert does not wait
                               # for it; that one sends the moment dwell is met.
    check_interval_seconds: 60 # how often to sample the camera during the window

    capture:
      # aspect_fix_width_scale: 2.0  # only needed for cameras that transmit anamorphic
                                      # frames without saying so (e.g. Hikvision "1080P
                                      # Lite" mode - half-width transmit, meant to be
                                      # displayed stretched). Check a raw frame against
                                      # real proportions before setting this. Default 0
                                      # (no correction) is right for most cameras.
      max_edge_px: 448          # fixed - crop happens first, this only caps the crop's
                                 # long edge, never upscales
      scaler: bicubic

    action:
      prompt: prompts/tank_people.txt
      resolve_when:
        - field: PEOPLE
          equals: YES
      resolve_match: all   # all | any - "all" (default) requires every condition in
                            # resolve_when to hold; "any" resolves if just one does.
                            # Use "any" when the prompt reports multiple independently-
                            # sufficient signals (e.g. either an operator checked the
                            # tank, or water was actually poured - either satisfies it).

    # How long presence must hold continuously before it counts. A single
    # positive frame is someone walking past or a false positive; two minutes
    # at the tanks is someone servicing them. This replaces asking the model
    # what the person is DOING - measured against a full day of real footage,
    # every action-phrased prompt either invented activity in empty rooms or
    # missed the real event, while presence it answers reliably. Set this to a
    # multiple of check_interval_seconds: 120s = 3 consecutive detections at
    # the 60s interval above. 0 disables it (any single positive resolves).
    dwell_seconds: 120

    # One inference call per object per check. Omit this list entirely to use
    # the full frame. Crop is [x, y, w, h] in source-frame pixels.
    #
    # Prefer ONE crop covering everything you care about over one per object.
    # Per-object attribution by drawing boxes on the frame does not work with
    # this model - proven three ways (naming the box colour, swapping which
    # colour marks which object, and stating the scene as fact all produced
    # "yes to whichever box you ask about"). A physical crop works because
    # ffmpeg does the framing rather than the model. Set it by eye against a
    # real frame; see README "Objects and crops".
    objects:
      - id: tank_area
        crop: [0, 0, 0, 0]   # placeholder - calibrate against a real frame

    require: all   # all | any - whether every object or just one must resolve

    camera_health:
      interval_seconds: 30 # runs 24x7, independent of the schedule above -
                           # a lightweight single-frame grab this often, all day
      miss_threshold: 2    # consecutive failed pulls before sending a "camera
                           # unreachable" alert. A "back online" alert fires
                           # once on recovery.

notifications:
  telegram:
    bot_token: ""   # from @BotFather on Telegram
    chat_id: "TBD"  # the chat/user/group to notify - message your bot once, then GET
                     # https://api.telegram.org/bot<TOKEN>/getUpdates to find it

model:
  path: "gguf/v35/OpenGVLab_InternVL3_5-2B-Q4_K_M.gguf"
  mmproj_path: "gguf/v35/mmproj-OpenGVLab_InternVL3_5-2B-f16.gguf"
  threads: 0                 # 0 = let llama.cpp auto-detect; set explicitly on weak CPUs
  timeout_seconds: 300        # per-check timeout; raise on slow/CPU-only hardware -
                              # vision encoding alone can take well over a minute there

local_alarm:
  enabled: true
  repeat_count: 3            # how many times to speak the alert out loud (macOS `say`)
